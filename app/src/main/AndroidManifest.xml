<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      监控是本应用的核心用户可见功能，需要长期在后台轮询 B 站直播状态，
      不属于 dataSync（一次性数据同步）语义。Android 15+ 对 dataSync 前台服务有
      「24 小时窗口内累计 6 小时」的硬上限，到点系统会强制停止，与"实时监控"需求冲突
      （doc_v2.4.md 0.5 亦明确指出不得把 dataSync 当作永久轮询方案）。
      specialUse 无该时长上限，需要声明子类型说明用途。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      精确闹钟：心跳用 setExactAndAllowWhileIdle 才能在 Doze 里准点唤醒。
      AOSP 的 javadoc 明确写着「用这个 API 排的闹钟，**即使应用在后台也允许启动前台服务**」——
      这正是"进程被杀后自己回来"需要的那条豁免。
      用 SCHEDULE_EXACT_ALARM（用户可授可撤）而**不是** USE_EXACT_ALARM：
      后者是 Google Play 的受限权限，只允许核心功能是闹钟/日历的应用声明。
      拿不到也不影响功能：代码会退化为 setAndAllowWhileIdle（不精确，但 Doze 下仍会触发）。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      这里**刻意不声明** SYSTEM_ALERT_WINDOW（「显示在其他应用上层」）。
      一度以为"仅持有该权限"就是"后台启动前台服务"的官方豁免（AOSP 里确有对应允许原因码
      REASON_SYSTEM_ALERT_WINDOW_PERMISSION = 62），但**实测推翻了它** ——
      Android 15 模拟器上用 root 触发一次真实的后台启动前台服务做 A/B：
        · 撤销悬浮窗 + 不在电池优化白名单 → `Background started FGS: Disallowed`
        · **只授予悬浮窗**（仍不在白名单）  → **同样 Disallowed**（没有豁免效果）
        · 只加入电池优化白名单             → `Background started FGS: Allowed`
      也就是说豁免看的是"应用**有可见窗口**"（真的去画悬浮窗），不是"持有权限"；
      而为了保活画 1px 悬浮窗正是本项目明确不做的灰色手段。既然没有实测收益，
      就不留这个敏感权限（少一个权限对用户更诚实）。详见台账 H75。
    -->

    <!--
      「忽略电池优化」：本应用的核心功能是长期后台监控，被系统按 Doze/待机回收就等于功能失效。
      加了它才能用 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 弹系统授权框
      （等价于把应用加进 Doze 白名单：Doze 期间仍可用 wakelock 与网络，
        并且是 Android 12+ 前台服务后台启动限制的官方豁免之一）。
      注意：Google Play 对该权限有政策限制（仅允许核心功能确需长期后台的应用使用）；
      本应用是本地优先的监控工具，侧载分发不涉及该政策。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      API 30+ 的包可见性：不声明 <queries> 就"看不见" Shizuku 是否安装，
      检测结果会永远是"未安装"（用户装了也用不了，且没有任何报错）。
      这里只声明包名，不申请任何额外权限。
    -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".BiliMonitorApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          ★ Shizuku 必需：provider AAR **自己不声明** provider（13.1.5 的清单里只有权限与 meta-data），
          不写这一段 binder 永远收不到 → Shizuku.pingBinder() 恒为 false →
          「用 Shizuku 应用」这一档 100% 不可用（按钮恒置灰、还误导用户"去启动 Shizuku"）。
          authorities 用 ${applicationId} 前缀避免与别的应用冲突；exported 必须为 true
          （Shizuku 应用要能回调它），访问由 permission 与 Shizuku 自己的校验共同限制。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
          保活心跳接收器：闹钟由 system_server 持有，**应用进程已经死了它照样触发**，
          触发时系统会拉起本应用进程，我们在 onReceive 里把监控服务重新拉起。
          exported=false：只接受我们自己 PendingIntent 发来的广播（外部无法伪造触发）。
        -->
        <receiver
            android:name=".background.KeepAliveHeartbeatReceiver"
            android:exported="false">
            <!--
              精确闹钟权限被撤销/重新授予时系统会删掉所有 setExact* 闹钟，心跳链会静默断掉 ——
              接住这个广播立刻重排（它同时也是"允许启动前台服务"的时机）。
              exported=false 仍能收到系统广播：AOSP 的组件权限检查对 system uid 无条件放行。
            -->
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
            <!--
              三条"零成本恢复入口"：用户改时间/时区/语言时系统会发这些广播，
              它们在 AOSP 允许原因码里同样允许启动前台服务（204/205/206），
              而且是 API 26+ 之后仍允许静态注册的少数隐式广播。
            -->
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".background.MonitoringService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_live_status_monitoring" />
        </service>

        <!--
          通知点击的跳板（用户要求"点击通知进直播间，优先哔哩哔哩客户端"）：
          透明、无历史、不进最近任务，onCreate 里决定跳客户端还是浏览器后立刻 finish。
          必须 exported=false —— 它只接受我们自己 PendingIntent 的调用。
        -->
        <activity
            android:name=".notify.LiveRoomRedirectActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="standard"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".background.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          更新后的「桌面入口自救援」（逻辑见 background/LauncherEntryRescueReceiver）。

          为什么必须有这么一条通道：图标/名称预设靠清单里的 activity-alias 别名切换，
          而**组件的启用状态跨 APK 更新持久化**。别名一旦改名（旧的单轴 IconPresetN 换成双轴
          IconPreset_i_j），旧别名的「已启用」状态随组件一起消失，主入口 MainActivity 的「已禁用」
          状态却被保留 —— 更新后桌面上一个入口都不剩、应用再也打不开，只能卸载重装（丢数据）。
          这条广播是自救的唯一入口。

          ★ 本注释刻意**不写**尖括号形式的 activity-alias 元素名：tools/generate-icon-presets.ps1
          会用裸文本在「标记区块之外」搜索该元素名来清理旧别名残留，注释里出现它会被误当成一个
          待删除的别名，从而吃掉后面的内容（脚本自己不报错，因为改完仍是合法 XML）。

          android:exported="false" 是**刻意**的，而且不影响接收这条由系统发出的广播：
          MY_PACKAGE_REPLACED 由 system_server（uid 1000）发送，而 AOSP 的
          ActivityManager.checkComponentPermission 对 root / system uid 在检查 exported
          之前就无条件放行（源码注释即 "Root, system server get to do everything"）；
          官方 <receiver> 文档亦写明 exported=false 时「仍能收到系统发出的消息」。
          保持 false = 最小暴露面：其它应用连这个组件都够不着。
          接收器内部另有一层防御：只有**确实一个启用的桌面入口都没有**时才动手，绝不信任广播本身。
        -->
        <receiver
            android:name=".background.LauncherEntryRescueReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".background.KeepAliveAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
