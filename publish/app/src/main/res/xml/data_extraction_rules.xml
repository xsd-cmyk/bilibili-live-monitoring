<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）的备份/迁移规则，语义与 res/xml/backup_rules.xml 一致。
  本应用 minSdk = 31，因此这份规则才是实际生效的那份；两份都保留是为了
  在低版本工具链与 `adb backup` 场景下行为一致（台账 H19-2.5 / C3）。

  排除凭证文件的理由见 backup_rules.xml 顶部说明：
  密文可以备份，但解它的 Keystore 密钥不能 —— 恢复后必然解不开。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bili_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bili_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
